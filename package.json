{
  "name": "dsh-anysearch-refs",
  "version": "0.1.0",
  "description": "在 DSH 侧边栏中展示 AnySearch 搜索引用卡片",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "anysearch",
    "sidebar",
    "search-refs"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "docs/**/*.md",
    "README.md",
    "LICENSE",
    "lib/client.js"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "build:client": "tsdown",
    "check": "vitest run && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@anysearch/anysearch-dsh": ">=0.1.0",
    "cordis": ">=4.0.0-rc.7",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
